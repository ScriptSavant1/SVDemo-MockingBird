<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.0</version>
    <relativePath/>
  </parent>

  <!-- Filled in by generator-worker per project -->
  <groupId>com.mockingbird.stubs</groupId>
  <artifactId>{{project_id}}-stub</artifactId>
  <version>1.0.0</version>
  <name>{{project_name}} Stub Engine</name>
  <description>Mockingbird auto-generated stub for {{project_name}}</description>

  <properties>
    <java.version>21</java.version>
    <wiremock.version>3.5.2</wiremock.version>
    <!-- WireMock 3.5.2 requires Jetty 11 (imports jetty-bom 11.0.20) and looks up its
         Jetty11HttpServerFactory via ServiceLoader at startup. spring-boot-starter-parent
         3.3.0 manages jetty-server to 12.0.9 (its default for spring-boot-starter-jetty
         users), which silently wins for that one artifact and leaves the rest of the
         Jetty stack (jetty-servlet, jetty-webapp, http2-server, ...) on 11.0.20 — a
         binary-incompatible mixed classpath. Symptom: FatalStartupException "Jetty 11 is
         not present" at runtime, NOT a compile error, so this only surfaces when the
         embedded server actually tries to start. Pinned below to keep the whole Jetty
         stack on the version WireMock actually ships against.
    -->
    <!-- NOT named jetty.version — spring-boot-dependencies already uses that property
         name internally for its own Jetty BOM management; reusing it here clobbers
         Spring's value and breaks unrelated managed artifacts (e.g. jetty-ee10-bom). -->
    <wiremock.jetty.version>11.0.20</wiremock.jetty.version>
  </properties>

  <!-- Re-import WireMock's own Jetty BOM so the WHOLE Jetty stack resolves to the
       version it actually ships against (11.0.20), not just jetty-server. Pinning
       individual artifacts one at a time is fragile — spring-boot-dependencies
       separately manages jetty-http, jetty-io, jetty-security, jetty-util, jetty-xml,
       jetty-proxy, jetty-client, and the alpn artifacts to 12.0.9, all of which would
       otherwise need pinning too. A same-pom dependencyManagement import takes
       precedence over the inherited parent's, so this wins for every GA it covers. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.eclipse.jetty</groupId>
        <artifactId>jetty-bom</artifactId>
        <version>${wiremock.jetty.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Spring's OWN embedded servlet container (port 8081: actuator + Spring-WS SOAP/WSDL
         routing) — needs to be Tomcat, not Jetty. WireMock manages its own independent
         Jetty 11 instance directly via WireMockServer (port 8080), so if Spring's web
         server were also Jetty-based, Spring Boot's auto-configuration would want Jetty 12
         (EE10 servlet packaging) while WireMock needs Jetty 11, and no single version
         satisfies both. Tomcat shares no classes with either Jetty major version, so this
         sidesteps the conflict entirely instead of trying to reconcile two Jetty majors on
         one classpath. spring-boot-starter-web supersedes the plain spring-boot-starter. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- WireMock as embedded HTTP stub server (NOT standalone JAR) -->
    <!-- Pulls in Jetty (11.0.20, pinned above) as a transitive compile dependency —
         Spring Boot manages the WireMockServer lifecycle via WireMockConfig. -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock</artifactId>
      <version>${wiremock.version}</version>
      <!-- Exclude embedded Jetty logging to use Spring Boot's Logback -->
      <exclusions>
        <exclusion>
          <groupId>org.eclipse.jetty</groupId>
          <artifactId>jetty-slf4j-impl</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- Prometheus metrics via /actuator/prometheus (scraped every 30s by platform) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Spring-WS core — SOAP endpoint routing and WSDL serving -->
    <dependency>
      <groupId>org.springframework.ws</groupId>
      <artifactId>spring-ws-core</artifactId>
    </dependency>

    <!-- WS-Security — UsernameToken validation for SOAP stubs -->
    <!-- Only activated when mockingbird.soap.ws-security.enabled=true -->
    <dependency>
      <groupId>org.springframework.ws</groupId>
      <artifactId>spring-ws-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.wss4j</groupId>
      <artifactId>wss4j-ws-security-dom</artifactId>
      <version>3.0.3</version>
    </dependency>

    <!-- HashiCorp Vault for secrets (Vault endpoint via Direct Connect in AWS) -->
    <dependency>
      <groupId>org.springframework.vault</groupId>
      <artifactId>spring-vault-core</artifactId>
      <version>3.1.0</version>
    </dependency>
  </dependencies>

  <build>
    <!-- Fixed output name (app.jar, not {{project_id}}-stub-1.0.0.jar) so the
         Dockerfile can COPY it by a literal path instead of a glob — the
         artifactId is a per-project slug and would never reliably match a
         fixed pattern. -->
    <finalName>app</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- Fat JAR — all deps bundled, no classpath issues on EC2 -->
          <mainClass>com.mockingbird.stubs.StubApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!-- All JARs resolved from Artifactory (configured in settings.xml) -->
  <!-- No public Maven Central access — all traffic via artifactory.internal -->

</project>
